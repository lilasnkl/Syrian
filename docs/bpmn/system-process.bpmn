    <bpmn:messageFlow id="MF_ProviderVerificationEvidence" name="Submit verification evidence" sourceRef="Task_ProviderSubmitVerification" targetRef="Sub_ProviderReadiness" />
    <bpmn:messageFlow id="MF_PlatformVerificationResult" name="Verification result" sourceRef="Sub_ProviderReadiness" targetRef="Event_ProviderVerificationResult" />
    <bpmn:messageFlow id="MF_ProviderKnowledgeUpload" name="Submit knowledge source" sourceRef="Task_ProviderUploadKnowledge" targetRef="Sub_KnowledgeRag" />
