<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SyrianServicesMarketplace" targetNamespace="https://syrian-services.local/bpmn">
  <bpmn:message id="Message_ServiceRequest" name="Service request" />
  <bpmn:message id="Message_ProviderOffer" name="Provider offer" />
  <bpmn:message id="Message_BidDecision" name="Bid decision" />
  <bpmn:message id="Message_Completion" name="Completion update" />
  <bpmn:message id="Message_Complaint" name="Complaint" />
  <bpmn:message id="Message_VerificationEvidence" name="Verification evidence" />
  <bpmn:message id="Message_VerificationResult" name="Verification result" />
  <bpmn:message id="Message_KnowledgeQuestion" name="Knowledge question" />
  <bpmn:message id="Message_AiRequest" name="AI request" />
  <bpmn:message id="Message_Notification" name="Notification" />
  <bpmn:process id="Process_Customer" name="Customer marketplace journey" isExecutable="false">
    <bpmn:startEvent id="Start_CustomerNeed" name="Service need identified" />
    <bpmn:userTask id="Task_CustomerSignIn" name="Register or sign in" />
    <bpmn:userTask id="Task_CustomerDiscover" name="Search providers, services, or ask AI recommendation" />
    <bpmn:userTask id="Task_CustomerAskRag" name="Ask provider knowledge question" />
    <bpmn:userTask id="Task_CustomerSubmitRequest" name="Submit service request" />
    <bpmn:userTask id="Task_CustomerReviewOffers" name="Review provider offers" />
    <bpmn:exclusiveGateway id="Gateway_CustomerDecision" name="Accept an offer?" />
    <bpmn:userTask id="Task_CustomerAcceptOffer" name="Accept selected offer" />
    <bpmn:userTask id="Task_CustomerRejectCancel" name="Reject offers or cancel request" />
    <bpmn:userTask id="Task_CustomerChatTrack" name="Chat and track in-progress work" />
    <bpmn:exclusiveGateway id="Gateway_CustomerOutcome" name="Was work acceptable?" />
    <bpmn:userTask id="Task_CustomerCreateComplaint" name="Submit complaint" />
    <bpmn:userTask id="Task_CustomerCreateReview" name="Create completed-order review" />
    <bpmn:endEvent id="End_CustomerCompleted" name="Service completed and reviewed" />
    <bpmn:endEvent id="End_CustomerCancelled" name="Request cancelled or no offer accepted" />
    <bpmn:endEvent id="End_CustomerDisputed" name="Complaint submitted" />
    <bpmn:sequenceFlow id="Flow_Customer_01" sourceRef="Start_CustomerNeed" targetRef="Task_CustomerSignIn" />
    <bpmn:sequenceFlow id="Flow_Customer_02" sourceRef="Task_CustomerSignIn" targetRef="Task_CustomerDiscover" />
    <bpmn:sequenceFlow id="Flow_Customer_03" sourceRef="Task_CustomerDiscover" targetRef="Task_CustomerAskRag" name="needs provider facts" />
    <bpmn:sequenceFlow id="Flow_Customer_04" sourceRef="Task_CustomerAskRag" targetRef="Task_CustomerSubmitRequest" />
    <bpmn:sequenceFlow id="Flow_Customer_05" sourceRef="Task_CustomerSubmitRequest" targetRef="Task_CustomerReviewOffers" />
    <bpmn:sequenceFlow id="Flow_Customer_06" sourceRef="Task_CustomerReviewOffers" targetRef="Gateway_CustomerDecision" />
    <bpmn:sequenceFlow id="Flow_Customer_07" sourceRef="Gateway_CustomerDecision" targetRef="Task_CustomerAcceptOffer" name="yes" />
    <bpmn:sequenceFlow id="Flow_Customer_08" sourceRef="Gateway_CustomerDecision" targetRef="Task_CustomerRejectCancel" name="no" />
    <bpmn:sequenceFlow id="Flow_Customer_09" sourceRef="Task_CustomerRejectCancel" targetRef="End_CustomerCancelled" />
    <bpmn:sequenceFlow id="Flow_Customer_10" sourceRef="Task_CustomerAcceptOffer" targetRef="Task_CustomerChatTrack" />
    <bpmn:sequenceFlow id="Flow_Customer_11" sourceRef="Task_CustomerChatTrack" targetRef="Gateway_CustomerOutcome" />
    <bpmn:sequenceFlow id="Flow_Customer_12" sourceRef="Gateway_CustomerOutcome" targetRef="Task_CustomerCreateReview" name="completed" />
    <bpmn:sequenceFlow id="Flow_Customer_13" sourceRef="Gateway_CustomerOutcome" targetRef="Task_CustomerCreateComplaint" name="disputed" />
    <bpmn:sequenceFlow id="Flow_Customer_14" sourceRef="Task_CustomerCreateComplaint" targetRef="End_CustomerDisputed" />
    <bpmn:sequenceFlow id="Flow_Customer_15" sourceRef="Task_CustomerCreateReview" targetRef="End_CustomerCompleted" />
  </bpmn:process>
  <bpmn:process id="Process_Provider" name="Provider marketplace journey" isExecutable="false">
    <bpmn:startEvent id="Start_ProviderJoin" name="Provider joins marketplace" />
    <bpmn:userTask id="Task_ProviderSignIn" name="Register or sign in as provider" />
    <bpmn:userTask id="Task_ProviderSubmitVerification" name="Submit verification evidence" />
    <bpmn:intermediateCatchEvent id="Event_ProviderVerificationResult" name="Verification result received">
      <bpmn:messageEventDefinition messageRef="Message_VerificationResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_ProviderVerified" name="Was provider verified?" />
    <bpmn:userTask id="Task_ProviderManageProfileServices" name="Manage profile and service listings" />
    <bpmn:userTask id="Task_ProviderUploadKnowledge" name="Upload provider knowledge source" />
    <bpmn:intermediateCatchEvent id="Event_ProviderRequestAvailable" name="Eligible request available">
      <bpmn:messageEventDefinition messageRef="Message_Notification" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ProviderSubmitBid" name="Submit offer" />
    <bpmn:exclusiveGateway id="Gateway_ProviderBidAccepted" name="Was offer accepted?" />
    <bpmn:userTask id="Task_ProviderPerformWork" name="Perform accepted service" />
    <bpmn:userTask id="Task_ProviderMarkCompleted" name="Mark order completed" />
    <bpmn:endEvent id="End_ProviderJobCompleted" name="Provider job completed" />
    <bpmn:endEvent id="End_ProviderVerificationRejected" name="Verification rejected or revoked" />
    <bpmn:endEvent id="End_ProviderOfferRejected" name="Offer rejected or withdrawn" />
    <bpmn:sequenceFlow id="Flow_Provider_01" sourceRef="Start_ProviderJoin" targetRef="Task_ProviderSignIn" />
    <bpmn:sequenceFlow id="Flow_Provider_02" sourceRef="Task_ProviderSignIn" targetRef="Task_ProviderSubmitVerification" />
    <bpmn:sequenceFlow id="Flow_Provider_03" sourceRef="Task_ProviderSubmitVerification" targetRef="Event_ProviderVerificationResult" />
    <bpmn:sequenceFlow id="Flow_Provider_04" sourceRef="Event_ProviderVerificationResult" targetRef="Gateway_ProviderVerified" />
    <bpmn:sequenceFlow id="Flow_Provider_05" sourceRef="Gateway_ProviderVerified" targetRef="Task_ProviderManageProfileServices" name="approved" />
    <bpmn:sequenceFlow id="Flow_Provider_06" sourceRef="Gateway_ProviderVerified" targetRef="End_ProviderVerificationRejected" name="rejected/revoked" />
    <bpmn:sequenceFlow id="Flow_Provider_07" sourceRef="Task_ProviderManageProfileServices" targetRef="Task_ProviderUploadKnowledge" />
    <bpmn:sequenceFlow id="Flow_Provider_08" sourceRef="Task_ProviderUploadKnowledge" targetRef="Event_ProviderRequestAvailable" />
    <bpmn:sequenceFlow id="Flow_Provider_09" sourceRef="Event_ProviderRequestAvailable" targetRef="Task_ProviderSubmitBid" />
    <bpmn:sequenceFlow id="Flow_Provider_10" sourceRef="Task_ProviderSubmitBid" targetRef="Gateway_ProviderBidAccepted" />
    <bpmn:sequenceFlow id="Flow_Provider_11" sourceRef="Gateway_ProviderBidAccepted" targetRef="Task_ProviderPerformWork" name="accepted" />
    <bpmn:sequenceFlow id="Flow_Provider_12" sourceRef="Gateway_ProviderBidAccepted" targetRef="End_ProviderOfferRejected" name="not accepted" />
    <bpmn:sequenceFlow id="Flow_Provider_13" sourceRef="Task_ProviderPerformWork" targetRef="Task_ProviderMarkCompleted" />
    <bpmn:sequenceFlow id="Flow_Provider_14" sourceRef="Task_ProviderMarkCompleted" targetRef="End_ProviderJobCompleted" />
  </bpmn:process>
  <bpmn:process id="Process_Admin" name="Admin and moderator operations" isExecutable="false">
    <bpmn:startEvent id="Start_AdminQueue" name="Admin queue notification received" />
    <bpmn:userTask id="Task_AdminViewDashboard" name="Review dashboard metrics and queues" />
    <bpmn:userTask id="Task_AdminReviewVerification" name="Approve, reject, or revoke verification" />
    <bpmn:exclusiveGateway id="Gateway_AdminApproveVerification" name="Approve provider?" />
    <bpmn:userTask id="Task_AdminApproveProvider" name="Approve provider verification" />
    <bpmn:userTask id="Task_AdminRejectProvider" name="Reject or revoke verification" />
    <bpmn:userTask id="Task_AdminHandleComplaint" name="Respond to complaint" />
    <bpmn:userTask id="Task_AdminModerateAccount" name="Block account or record moderation action" />
    <bpmn:endEvent id="End_AdminQueuesHandled" name="Admin queue handled" />
    <bpmn:sequenceFlow id="Flow_Admin_01" sourceRef="Start_AdminQueue" targetRef="Task_AdminViewDashboard" />
    <bpmn:sequenceFlow id="Flow_Admin_02" sourceRef="Task_AdminViewDashboard" targetRef="Task_AdminReviewVerification" />
    <bpmn:sequenceFlow id="Flow_Admin_03" sourceRef="Task_AdminReviewVerification" targetRef="Gateway_AdminApproveVerification" />
    <bpmn:sequenceFlow id="Flow_Admin_04" sourceRef="Gateway_AdminApproveVerification" targetRef="Task_AdminApproveProvider" name="yes" />
    <bpmn:sequenceFlow id="Flow_Admin_05" sourceRef="Gateway_AdminApproveVerification" targetRef="Task_AdminRejectProvider" name="no/revoke" />
    <bpmn:sequenceFlow id="Flow_Admin_06" sourceRef="Task_AdminApproveProvider" targetRef="Task_AdminHandleComplaint" />
    <bpmn:sequenceFlow id="Flow_Admin_07" sourceRef="Task_AdminRejectProvider" targetRef="Task_AdminHandleComplaint" />
    <bpmn:sequenceFlow id="Flow_Admin_08" sourceRef="Task_AdminHandleComplaint" targetRef="Task_AdminModerateAccount" />
    <bpmn:sequenceFlow id="Flow_Admin_09" sourceRef="Task_AdminModerateAccount" targetRef="End_AdminQueuesHandled" />
  </bpmn:process>
  <bpmn:process id="Process_Platform" name="Syrian Services platform orchestration" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_Platform">
      <bpmn:lane id="Lane_Platform_Frontend" name="React Frontend">
        <bpmn:flowNodeRef>Start_PlatformRequestReceived</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlatformRouteFrontend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Platform_AuthApi" name="Django API and Auth">
        <bpmn:flowNodeRef>Sub_Auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlatformAuth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PlatformAuthFailed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Platform_Domain" name="Domain Services">
        <bpmn:flowNodeRef>Sub_ProviderReadiness</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlatformProviderApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PlatformProviderRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_Discovery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_KnowledgeRag</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_OrderSubmission</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlatformRequestValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PlatformValidationFailed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_BidWorkflow</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlatformOfferAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PlatformNoOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_FulfillmentChat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlatformFulfillmentOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_ReviewRating</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EarningsAnalytics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sub_ComplaintModeration</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PlatformCompleted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PlatformCancelled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_PlatformDisputed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Platform_Worker" name="Notifications and Background Jobs">
        <bpmn:flowNodeRef>Sub_NotificationsAudit</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Platform_Data" name="Persistence, Files, Vector Index, Cache" />
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_PlatformRequestReceived" name="Marketplace request received" />
    <bpmn:serviceTask id="Task_PlatformRouteFrontend" name="Route action through React SPA" />
    <bpmn:subProcess id="Sub_Auth" name="Authenticate session and check active account" triggeredByEvent="false">
      <bpmn:startEvent id="Start_SubAuth" name="Protected action requested" />
      <bpmn:serviceTask id="Task_AuthReadCookies" name="Read HttpOnly JWT cookies and CSRF token" />
      <bpmn:serviceTask id="Task_AuthValidateJwt" name="Validate JWT and refresh token if requested" />
      <bpmn:serviceTask id="Task_AuthLoadUser" name="Load user role and account status" />
      <bpmn:exclusiveGateway id="Gateway_AuthActive" name="Is user authenticated and active?" />
      <bpmn:endEvent id="End_SubAuthOk" name="Authorization passed" />
      <bpmn:endEvent id="End_SubAuthFailed" name="Authentication, permission, or blocked-account error" />
      <bpmn:sequenceFlow id="Flow_SubAuth_01" sourceRef="Start_SubAuth" targetRef="Task_AuthReadCookies" />
      <bpmn:sequenceFlow id="Flow_SubAuth_02" sourceRef="Task_AuthReadCookies" targetRef="Task_AuthValidateJwt" />
      <bpmn:sequenceFlow id="Flow_SubAuth_03" sourceRef="Task_AuthValidateJwt" targetRef="Task_AuthLoadUser" />
      <bpmn:sequenceFlow id="Flow_SubAuth_04" sourceRef="Task_AuthLoadUser" targetRef="Gateway_AuthActive" />
      <bpmn:sequenceFlow id="Flow_SubAuth_05" sourceRef="Gateway_AuthActive" targetRef="End_SubAuthOk" name="yes" />
      <bpmn:sequenceFlow id="Flow_SubAuth_06" sourceRef="Gateway_AuthActive" targetRef="End_SubAuthFailed" name="no" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_PlatformAuth" name="Is actor authorized?" />
    <bpmn:endEvent id="End_PlatformAuthFailed" name="Authentication or account status failed" />
    <bpmn:subProcess id="Sub_ProviderReadiness" name="Verify provider and publish services" triggeredByEvent="false">
      <bpmn:startEvent id="Start_SubProviderReady" name="Provider readiness requested" />
      <bpmn:serviceTask id="Task_ProviderValidateRole" name="Validate provider role and active account" />
      <bpmn:receiveTask id="Task_ProviderReceiveEvidence" name="Receive verification documents and files" />
      <bpmn:serviceTask id="Task_ProviderStoreVerification" name="Store files and create verification request" />
      <bpmn:serviceTask id="Task_ProviderNotifyAdmins" name="Notify admins and moderators" />
      <bpmn:userTask id="Task_ProviderAdminReview" name="Review submitted verification evidence" />
      <bpmn:exclusiveGateway id="Gateway_ProviderApproval" name="Approve verification?" />
      <bpmn:serviceTask id="Task_ProviderSetVerified" name="Set provider as verified" />
      <bpmn:serviceTask id="Task_ProviderRejectOrRevoke" name="Reject or revoke verification with reason" />
      <bpmn:serviceTask id="Task_ProviderPublishServices" name="Allow provider profile, services, and earnings access" />
      <bpmn:endEvent id="End_SubProviderReady" name="Provider ready" />
      <bpmn:endEvent id="End_SubProviderRejected" name="Provider verification rejected or revoked" />
      <bpmn:sequenceFlow id="Flow_SubProvider_01" sourceRef="Start_SubProviderReady" targetRef="Task_ProviderValidateRole" />
      <bpmn:sequenceFlow id="Flow_SubProvider_02" sourceRef="Task_ProviderValidateRole" targetRef="Task_ProviderReceiveEvidence" />
      <bpmn:sequenceFlow id="Flow_SubProvider_03" sourceRef="Task_ProviderReceiveEvidence" targetRef="Task_ProviderStoreVerification" />
      <bpmn:sequenceFlow id="Flow_SubProvider_04" sourceRef="Task_ProviderStoreVerification" targetRef="Task_ProviderNotifyAdmins" />
      <bpmn:sequenceFlow id="Flow_SubProvider_05" sourceRef="Task_ProviderNotifyAdmins" targetRef="Task_ProviderAdminReview" />
      <bpmn:sequenceFlow id="Flow_SubProvider_06" sourceRef="Task_ProviderAdminReview" targetRef="Gateway_ProviderApproval" />
      <bpmn:sequenceFlow id="Flow_SubProvider_07" sourceRef="Gateway_ProviderApproval" targetRef="Task_ProviderSetVerified" name="yes" />
      <bpmn:sequenceFlow id="Flow_SubProvider_08" sourceRef="Gateway_ProviderApproval" targetRef="Task_ProviderRejectOrRevoke" name="no/revoke" />
      <bpmn:sequenceFlow id="Flow_SubProvider_09" sourceRef="Task_ProviderSetVerified" targetRef="Task_ProviderPublishServices" />
      <bpmn:sequenceFlow id="Flow_SubProvider_10" sourceRef="Task_ProviderPublishServices" targetRef="End_SubProviderReady" />
      <bpmn:sequenceFlow id="Flow_SubProvider_11" sourceRef="Task_ProviderRejectOrRevoke" targetRef="End_SubProviderRejected" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_PlatformProviderApproved" name="Is provider approved or not required?" />
    <bpmn:endEvent id="End_PlatformProviderRejected" name="Provider cannot publish verified work" />
    <bpmn:subProcess id="Sub_Discovery" name="Support discovery and AI recommendation" triggeredByEvent="false">
      <bpmn:startEvent id="Start_SubDiscovery" name="Customer discovery requested" />
      <bpmn:serviceTask id="Task_DiscoveryListProviders" name="List and filter providers and active services" />
      <bpmn:serviceTask id="Task_DiscoveryAnalyzeProblem" name="Call Ollama problem analysis" />
      <bpmn:scriptTask id="Task_DiscoveryNormalizeRank" name="Normalize analysis and rank matching providers" />
      <bpmn:endEvent id="End_SubDiscovery" name="Discovery results returned" />
      <bpmn:endEvent id="End_SubDiscoveryExternalFailed" name="AI recommendation unavailable" />
      <bpmn:sequenceFlow id="Flow_SubDiscovery_01" sourceRef="Start_SubDiscovery" targetRef="Task_DiscoveryListProviders" />
      <bpmn:sequenceFlow id="Flow_SubDiscovery_02" sourceRef="Task_DiscoveryListProviders" targetRef="Task_DiscoveryAnalyzeProblem" name="AI recommendation requested" />
      <bpmn:sequenceFlow id="Flow_SubDiscovery_03" sourceRef="Task_DiscoveryAnalyzeProblem" targetRef="Task_DiscoveryNormalizeRank" name="valid model output" />
      <bpmn:sequenceFlow id="Flow_SubDiscovery_04" sourceRef="Task_DiscoveryNormalizeRank" targetRef="End_SubDiscovery" />
      <bpmn:sequenceFlow id="Flow_SubDiscovery_05" sourceRef="Task_DiscoveryAnalyzeProblem" targetRef="End_SubDiscoveryExternalFailed" name="Ollama unavailable or invalid after retry" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_KnowledgeRag" name="Answer provider knowledge question" triggeredByEvent="false">
      <bpmn:startEvent id="Start_SubKnowledge" name="Knowledge or assistant action received" />
      <bpmn:exclusiveGateway id="Gateway_KnowledgeAction" name="Upload source or ask question?" />
      <bpmn:serviceTask id="Task_KnowledgeValidateUpload" name="Validate provider, visibility, file type, and size" />
      <bpmn:serviceTask id="Task_KnowledgeStoreSource" name="Store source file and queue ingestion job" />
      <bpmn:serviceTask id="Task_KnowledgeExtractText" name="Extract and normalize text" />
      <bpmn:scriptTask id="Task_KnowledgeChunkText" name="Create semantic chunks" />
      <bpmn:serviceTask id="Task_KnowledgeEmbedChunks" name="Call OpenAI embeddings" />
      <bpmn:serviceTask id="Task_KnowledgeActivateChunks" name="Activate chunks and sync vector index" />
      <bpmn:endEvent id="End_KnowledgeActive" name="Knowledge source active" />
      <bpmn:serviceTask id="Task_RagValidateQuestion" name="Validate customer, provider, service, and order scope" />
      <bpmn:serviceTask id="Task_RagRetrieveEvidence" name="Retrieve authorized chunks by visibility policy" />
      <bpmn:exclusiveGateway id="Gateway_RagEvidence" name="Is relevant evidence available?" />
      <bpmn:serviceTask id="Task_RagCallOpenAI" name="Call OpenAI Responses API for grounded answer" />
      <bpmn:scriptTask id="Task_RagValidateOutput" name="Validate structured output and citations" />
      <bpmn:serviceTask id="Task_RagPersistTurn" name="Persist assistant turn, usage, and citations" />
      <bpmn:endEvent id="End_RagAnswered" name="Grounded answer returned" />
      <bpmn:endEvent id="End_RagInsufficient" name="Insufficient evidence returned" />
      <bpmn:endEvent id="End_KnowledgeFailed" name="Knowledge or AI processing failed" />
      <bpmn:boundaryEvent id="Boundary_KnowledgeEmbeddingFailed" name="OpenAI embedding failed" attachedToRef="Task_KnowledgeEmbedChunks" cancelActivity="true">
        <bpmn:errorEventDefinition />
      </bpmn:boundaryEvent>
      <bpmn:boundaryEvent id="Boundary_RagAnswerFailed" name="OpenAI answer failed" attachedToRef="Task_RagCallOpenAI" cancelActivity="true">
        <bpmn:errorEventDefinition />
      </bpmn:boundaryEvent>
      <bpmn:sequenceFlow id="Flow_SubKnowledge_01" sourceRef="Start_SubKnowledge" targetRef="Gateway_KnowledgeAction" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_02" sourceRef="Gateway_KnowledgeAction" targetRef="Task_KnowledgeValidateUpload" name="provider upload" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_03" sourceRef="Task_KnowledgeValidateUpload" targetRef="Task_KnowledgeStoreSource" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_04" sourceRef="Task_KnowledgeStoreSource" targetRef="Task_KnowledgeExtractText" name="worker or process-now" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_05" sourceRef="Task_KnowledgeExtractText" targetRef="Task_KnowledgeChunkText" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_06" sourceRef="Task_KnowledgeChunkText" targetRef="Task_KnowledgeEmbedChunks" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_07" sourceRef="Task_KnowledgeEmbedChunks" targetRef="Task_KnowledgeActivateChunks" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_08" sourceRef="Task_KnowledgeActivateChunks" targetRef="End_KnowledgeActive" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_09" sourceRef="Gateway_KnowledgeAction" targetRef="Task_RagValidateQuestion" name="customer question" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_10" sourceRef="Task_RagValidateQuestion" targetRef="Task_RagRetrieveEvidence" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_11" sourceRef="Task_RagRetrieveEvidence" targetRef="Gateway_RagEvidence" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_12" sourceRef="Gateway_RagEvidence" targetRef="End_RagInsufficient" name="no" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_13" sourceRef="Gateway_RagEvidence" targetRef="Task_RagCallOpenAI" name="yes" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_14" sourceRef="Task_RagCallOpenAI" targetRef="Task_RagValidateOutput" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_15" sourceRef="Task_RagValidateOutput" targetRef="Task_RagPersistTurn" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_16" sourceRef="Task_RagPersistTurn" targetRef="End_RagAnswered" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_17" sourceRef="Boundary_KnowledgeEmbeddingFailed" targetRef="End_KnowledgeFailed" />
      <bpmn:sequenceFlow id="Flow_SubKnowledge_18" sourceRef="Boundary_RagAnswerFailed" targetRef="End_KnowledgeFailed" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_OrderSubmission" name="Create customer service request" triggeredByEvent="false">
      <bpmn:startEvent id="Start_SubOrder" name="Order submission received" />
      <bpmn:serviceTask id="Task_OrderValidateCustomer" name="Validate customer role and required fields" />
      <bpmn:serviceTask id="Task_OrderValidateService" name="Validate selected service is active and category matches" />
      <bpmn:exclusiveGateway id="Gateway_OrderValid" name="Is order valid?" />
      <bpmn:serviceTask id="Task_OrderCreateOpen" name="Create open order record" />
      <bpmn:exclusiveGateway id="Gateway_OrderTargeted" name="Is request service-targeted?" />
      <bpmn:serviceTask id="Task_OrderNotifySelectedProvider" name="Notify selected provider" />
      <bpmn:serviceTask id="Task_OrderExposeToMatchingProviders" name="Expose open request to matching providers" />
      <bpmn:endEvent id="End_SubOrderCreated" name="Order created" />
      <bpmn:endEvent id="End_SubOrderInvalid" name="Validation or permission error" />
      <bpmn:sequenceFlow id="Flow_SubOrder_01" sourceRef="Start_SubOrder" targetRef="Task_OrderValidateCustomer" />
      <bpmn:sequenceFlow id="Flow_SubOrder_02" sourceRef="Task_OrderValidateCustomer" targetRef="Task_OrderValidateService" />
      <bpmn:sequenceFlow id="Flow_SubOrder_03" sourceRef="Task_OrderValidateService" targetRef="Gateway_OrderValid" />
      <bpmn:sequenceFlow id="Flow_SubOrder_04" sourceRef="Gateway_OrderValid" targetRef="End_SubOrderInvalid" name="no" />
      <bpmn:sequenceFlow id="Flow_SubOrder_05" sourceRef="Gateway_OrderValid" targetRef="Task_OrderCreateOpen" name="yes" />
      <bpmn:sequenceFlow id="Flow_SubOrder_06" sourceRef="Task_OrderCreateOpen" targetRef="Gateway_OrderTargeted" />
      <bpmn:sequenceFlow id="Flow_SubOrder_07" sourceRef="Gateway_OrderTargeted" targetRef="Task_OrderNotifySelectedProvider" name="yes" />
      <bpmn:sequenceFlow id="Flow_SubOrder_08" sourceRef="Gateway_OrderTargeted" targetRef="Task_OrderExposeToMatchingProviders" name="no" />
      <bpmn:sequenceFlow id="Flow_SubOrder_09" sourceRef="Task_OrderNotifySelectedProvider" targetRef="End_SubOrderCreated" />
      <bpmn:sequenceFlow id="Flow_SubOrder_10" sourceRef="Task_OrderExposeToMatchingProviders" targetRef="End_SubOrderCreated" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_PlatformRequestValid" name="Is request valid and visible?" />
    <bpmn:endEvent id="End_PlatformValidationFailed" name="Request validation failed" />
    <bpmn:subProcess id="Sub_BidWorkflow" name="Manage provider offers and selection" triggeredByEvent="false">
      <bpmn:startEvent id="Start_SubBid" name="Bid action received" />
      <bpmn:serviceTask id="Task_BidValidateProvider" name="Validate provider profile, category, open order, and duplicate bid" />
      <bpmn:exclusiveGateway id="Gateway_BidEligible" name="Is provider eligible to bid?" />
      <bpmn:serviceTask id="Task_BidCreate" name="Create pending bid and notify customer" />
      <bpmn:receiveTask id="Task_BidReceiveDecision" name="Receive customer or moderator bid decision" />
      <bpmn:exclusiveGateway id="Gateway_BidDecision" name="Accept offer?" />
      <bpmn:serviceTask id="Task_BidAccept" name="Accept selected bid and reject competing pending bids" />
      <bpmn:serviceTask id="Task_BidRejectWithdraw" name="Reject or withdraw pending bid" />
      <bpmn:serviceTask id="Task_BidSyncOrder" name="Sync order status and awarded provider" />
      <bpmn:exclusiveGateway id="Gateway_BidPendingRemain" name="Any pending offers remain?" />
      <bpmn:endEvent id="End_SubBidAccepted" name="Order moved to in progress" />
      <bpmn:endEvent id="End_SubBidStillOpen" name="Order remains open" />
      <bpmn:endEvent id="End_SubBidCancelled" name="Order cancelled" />
      <bpmn:endEvent id="End_SubBidInvalid" name="Bid rejected by validation" />
      <bpmn:sequenceFlow id="Flow_SubBid_01" sourceRef="Start_SubBid" targetRef="Task_BidValidateProvider" />
      <bpmn:sequenceFlow id="Flow_SubBid_02" sourceRef="Task_BidValidateProvider" targetRef="Gateway_BidEligible" />
      <bpmn:sequenceFlow id="Flow_SubBid_03" sourceRef="Gateway_BidEligible" targetRef="End_SubBidInvalid" name="no" />
      <bpmn:sequenceFlow id="Flow_SubBid_04" sourceRef="Gateway_BidEligible" targetRef="Task_BidCreate" name="yes" />
      <bpmn:sequenceFlow id="Flow_SubBid_05" sourceRef="Task_BidCreate" targetRef="Task_BidReceiveDecision" />
      <bpmn:sequenceFlow id="Flow_SubBid_06" sourceRef="Task_BidReceiveDecision" targetRef="Gateway_BidDecision" />
      <bpmn:sequenceFlow id="Flow_SubBid_07" sourceRef="Gateway_BidDecision" targetRef="Task_BidAccept" name="yes" />
      <bpmn:sequenceFlow id="Flow_SubBid_08" sourceRef="Gateway_BidDecision" targetRef="Task_BidRejectWithdraw" name="no" />
      <bpmn:sequenceFlow id="Flow_SubBid_09" sourceRef="Task_BidAccept" targetRef="Task_BidSyncOrder" />
      <bpmn:sequenceFlow id="Flow_SubBid_10" sourceRef="Task_BidRejectWithdraw" targetRef="Task_BidSyncOrder" />
      <bpmn:sequenceFlow id="Flow_SubBid_11" sourceRef="Task_BidSyncOrder" targetRef="Gateway_BidPendingRemain" />
      <bpmn:sequenceFlow id="Flow_SubBid_12" sourceRef="Gateway_BidPendingRemain" targetRef="End_SubBidAccepted" name="accepted bid exists" />
      <bpmn:sequenceFlow id="Flow_SubBid_13" sourceRef="Gateway_BidPendingRemain" targetRef="End_SubBidStillOpen" name="pending offers remain" />
      <bpmn:sequenceFlow id="Flow_SubBid_14" sourceRef="Gateway_BidPendingRemain" targetRef="End_SubBidCancelled" name="only rejected offers" />
    </bpmn:subProcess>
    <bpmn:subProcess id="Sub_NotificationsAudit" name="Create notifications and status history" triggeredByEvent="false">
      <bpmn:startEvent id="Start_SubNotify" name="Domain event emitted" />
      <bpmn:serviceTask id="Task_NotifyCreate" name="Create in-app notification record" />
      <bpmn:serviceTask id="Task_NotifyHistory" name="Write bid, order, or complaint history" />
      <bpmn:serviceTask id="Task_NotifyFilterVisible" name="Filter visible notifications by role" />
      <bpmn:endEvent id="End_SubNotify" name="Notification and history available" />
      <bpmn:sequenceFlow id="Flow_SubNotify_01" sourceRef="Start_SubNotify" targetRef="Task_NotifyCreate" />
      <bpmn:sequenceFlow id="Flow_SubNotify_02" sourceRef="Task_NotifyCreate" targetRef="Task_NotifyHistory" />
      <bpmn:sequenceFlow id="Flow_SubNotify_03" sourceRef="Task_NotifyHistory" targetRef="Task_NotifyFilterVisible" />
      <bpmn:sequenceFlow id="Flow_SubNotify_04" sourceRef="Task_NotifyFilterVisible" targetRef="End_SubNotify" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_PlatformOfferAccepted" name="Was an offer accepted?" />
    <bpmn:endEvent id="End_PlatformNoOffer" name="Request cancelled or left open" />
    <bpmn:subProcess id="Sub_FulfillmentChat" name="Coordinate work and chat" triggeredByEvent="false">
      <bpmn:startEvent id="Start_SubFulfillment" name="Accepted order in progress" />
      <bpmn:serviceTask id="Task_ChatCreateConversation" name="Create or reuse customer-provider conversation" />
      <bpmn:userTask id="Task_ChatExchangeMessages" name="Exchange messages during work" />
      <bpmn:serviceTask id="Task_OrderCompleteCancelDispute" name="Apply completion, cancellation, or dispute transition" />
      <bpmn:exclusiveGateway id="Gateway_FulfillmentOutcome" name="Which final state?" />
      <bpmn:endEvent id="End_FulfillmentCompleted" name="Completed" />
      <bpmn:endEvent id="End_FulfillmentCancelled" name="Cancelled" />
      <bpmn:endEvent id="End_FulfillmentDisputed" name="Disputed" />
      <bpmn:sequenceFlow id="Flow_SubFulfillment_01" sourceRef="Start_SubFulfillment" targetRef="Task_ChatCreateConversation" />
      <bpmn:sequenceFlow id="Flow_SubFulfillment_02" sourceRef="Task_ChatCreateConversation" targetRef="Task_ChatExchangeMessages" />
      <bpmn:sequenceFlow id="Flow_SubFulfillment_03" sourceRef="Task_ChatExchangeMessages" targetRef="Task_OrderCompleteCancelDispute" />
      <bpmn:sequenceFlow id="Flow_SubFulfillment_04" sourceRef="Task_OrderCompleteCancelDispute" targetRef="Gateway_FulfillmentOutcome" />
      <bpmn:sequenceFlow id="Flow_SubFulfillment_05" sourceRef="Gateway_FulfillmentOutcome" targetRef="End_FulfillmentCompleted" name="completed" />
      <bpmn:sequenceFlow id="Flow_SubFulfillment_06" sourceRef="Gateway_FulfillmentOutcome" targetRef="End_FulfillmentCancelled" name="cancelled" />
      <bpmn:sequenceFlow id="Flow_SubFulfillment_07" sourceRef="Gateway_FulfillmentOutcome" targetRef="End_FulfillmentDisputed" name="disputed" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="Gateway_PlatformFulfillmentOutcome" name="Completed, cancelled, or disputed?" />
    <bpmn:subProcess id="Sub_ReviewRating" name="Record review and refresh provider rating" triggeredByEvent="false">
      <bpmn:startEvent id="Start_SubReview" name="Review submitted" />
      <bpmn:serviceTask id="Task_ReviewValidate" name="Validate owner, completed order, provider, and duplicate review" />
      <bpmn:serviceTask id="Task_ReviewCreate" name="Create review" />
      <bpmn:scriptTask id="Task_ReviewAggregate" name="Refresh provider average rating and review count" />
      <bpmn:endEvent id="End_SubReview" name="Review recorded" />
      <bpmn:endEvent id="End_SubReviewRejected" name="Review rejected by business rule" />
      <bpmn:sequenceFlow id="Flow_SubReview_01" sourceRef="Start_SubReview" targetRef="Task_ReviewValidate" />
      <bpmn:sequenceFlow id="Flow_SubReview_02" sourceRef="Task_ReviewValidate" targetRef="Task_ReviewCreate" name="valid" />
      <bpmn:sequenceFlow id="Flow_SubReview_03" sourceRef="Task_ReviewValidate" targetRef="End_SubReviewRejected" name="invalid" />
      <bpmn:sequenceFlow id="Flow_SubReview_04" sourceRef="Task_ReviewCreate" targetRef="Task_ReviewAggregate" />
      <bpmn:sequenceFlow id="Flow_SubReview_05" sourceRef="Task_ReviewAggregate" targetRef="End_SubReview" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="Task_EarningsAnalytics" name="Calculate earnings and dashboard metrics" />
    <bpmn:subProcess id="Sub_ComplaintModeration" name="Resolve complaint or escalation" triggeredByEvent="false">
      <bpmn:startEvent id="Start_SubComplaint" name="Complaint submitted" />
      <bpmn:serviceTask id="Task_ComplaintCreate" name="Create complaint and action log" />
      <bpmn:serviceTask id="Task_ComplaintNotifyAdmins" name="Notify admins and moderators" />
      <bpmn:userTask id="Task_ComplaintAdminRespond" name="Admin or moderator responds" />
      <bpmn:exclusiveGateway id="Gateway_ComplaintOutcome" name="Resolved, dismissed, or escalated?" />
      <bpmn:serviceTask id="Task_ComplaintModerateAccount" name="Block account or revoke verification if needed" />
      <bpmn:endEvent id="End_ComplaintResolved" name="Complaint resolved" />
      <bpmn:endEvent id="End_ComplaintDismissed" name="Complaint dismissed" />
      <bpmn:endEvent id="End_ComplaintEscalated" name="Complaint escalated" />
      <bpmn:sequenceFlow id="Flow_SubComplaint_01" sourceRef="Start_SubComplaint" targetRef="Task_ComplaintCreate" />
      <bpmn:sequenceFlow id="Flow_SubComplaint_02" sourceRef="Task_ComplaintCreate" targetRef="Task_ComplaintNotifyAdmins" />
      <bpmn:sequenceFlow id="Flow_SubComplaint_03" sourceRef="Task_ComplaintNotifyAdmins" targetRef="Task_ComplaintAdminRespond" />
      <bpmn:sequenceFlow id="Flow_SubComplaint_04" sourceRef="Task_ComplaintAdminRespond" targetRef="Gateway_ComplaintOutcome" />
      <bpmn:sequenceFlow id="Flow_SubComplaint_05" sourceRef="Gateway_ComplaintOutcome" targetRef="End_ComplaintResolved" name="resolved" />
      <bpmn:sequenceFlow id="Flow_SubComplaint_06" sourceRef="Gateway_ComplaintOutcome" targetRef="End_ComplaintDismissed" name="dismissed" />
      <bpmn:sequenceFlow id="Flow_SubComplaint_07" sourceRef="Gateway_ComplaintOutcome" targetRef="Task_ComplaintModerateAccount" name="escalated" />
      <bpmn:sequenceFlow id="Flow_SubComplaint_08" sourceRef="Task_ComplaintModerateAccount" targetRef="End_ComplaintEscalated" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_PlatformCompleted" name="Request completed" />
    <bpmn:endEvent id="End_PlatformCancelled" name="Request cancelled" />
    <bpmn:endEvent id="End_PlatformDisputed" name="Complaint resolved or escalated" />
    <bpmn:sequenceFlow id="Flow_Platform_01" sourceRef="Start_PlatformRequestReceived" targetRef="Task_PlatformRouteFrontend" />
