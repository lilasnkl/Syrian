  <bpmn:process id="Process_Ollama" name="Local Ollama recommendation service" isExecutable="false">
    <bpmn:startEvent id="Start_OllamaRequest" name="Problem analysis requested">
      <bpmn:messageEventDefinition messageRef="Message_AiRequest" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_OllamaAnalyze" name="Analyze problem with Ollama model" />
    <bpmn:endEvent id="End_OllamaResponse" name="Structured recommendation returned" />
    <bpmn:sequenceFlow id="Flow_Ollama_01" sourceRef="Start_OllamaRequest" targetRef="Task_OllamaAnalyze" />
    <bpmn:sequenceFlow id="Flow_Ollama_02" sourceRef="Task_OllamaAnalyze" targetRef="End_OllamaResponse" />
  </bpmn:process>
  <bpmn:process id="Process_OpenAI" name="OpenAI API processing" isExecutable="false">
    <bpmn:startEvent id="Start_OpenAIRequest" name="OpenAI request received">
      <bpmn:messageEventDefinition messageRef="Message_AiRequest" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_OpenAIEmbed" name="Create embeddings" />
    <bpmn:serviceTask id="Task_OpenAIGenerate" name="Generate structured grounded answer" />
    <bpmn:endEvent id="End_OpenAIResponse" name="OpenAI result returned" />
    <bpmn:sequenceFlow id="Flow_OpenAI_01" sourceRef="Start_OpenAIRequest" targetRef="Task_OpenAIEmbed" />
    <bpmn:sequenceFlow id="Flow_OpenAI_02" sourceRef="Task_OpenAIEmbed" targetRef="Task_OpenAIGenerate" />
    <bpmn:sequenceFlow id="Flow_OpenAI_03" sourceRef="Task_OpenAIGenerate" targetRef="End_OpenAIResponse" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_SyrianServices">
    <bpmn:participant id="Participant_Customer" name="Customer" processRef="Process_Customer" />
